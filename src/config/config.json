{
    "model_name": "MobileNetV2", 
    "input_shape": [224, 224, 3],
    "optimizer": "adam",
    "learning_rate": 0.001,
    "batch_size": 32,
    "epochs": 10,
    "loss_function": "cross_entropy",
    "callbacks": {
        "early_stopping": {
            "metric":"val_loss",
            "patience": 5
        },
        "reduce_lr": {
            "factor": 0.1,
            "patience": 3
        }
    },
    "augmentation": {
        "normalize_mean": [0.485, 0.456, 0.406],
        "normalize_std": [0.229, 0.224, 0.225]
    }
}
