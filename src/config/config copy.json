{
    // "model_name": "Xception", "BaseCNN","Xception","ResNet50","MobileNetV2","VGG16"
    "input_shape": [224, 224, 3],
    "optimizer": "adam",
    "learning_rate": 0.0001,
    "batch_size": 32,
    "epochs": 20,
    "loss_function": "cross_entropy",
    "callbacks": {
        "early_stopping": {
            // "monitor": "val_loss",
            "patience": 5
        },
        "reduce_lr": {
            // "monitor": "val_loss",
            "factor": 0.1,
            "patience": 3
        }
        // "model_checkpoint": {
        //     "monitor": "val_accuracy",
        //     "save_best_only": true
        // }
    },
    "augmentation": {
        "normalize_mean": [0.485, 0.456, 0.406],
        "normalize_std": [0.229, 0.224, 0.225],
        "rotation_range": 20,
        "horizontal_flip": true
        // "width_shift_range": 0.2,
        // "height_shift_range": 0.2,
        // "shear_range": 0.2,
        // "zoom_range": 0.2,
    }
}
